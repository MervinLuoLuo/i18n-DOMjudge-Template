{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}队伍 - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}

    <h1>队伍</h1>

    {{ macros.table(teams, table_fields) }}

    {%- if is_granted('ROLE_ADMIN') %}
        <p class="mt-4">
            {% include 'jury/partials/_delete_button.html.twig' with {'entities': teams} %}
            {{ button(path('jury_team_add'), '添加队伍', 'primary', 'plus') }}
            {{ button(path('jury_import_export', {'_fragment':'teams'}), '导入队伍', 'primary', 'upload') }}
        </p>
    {%- endif %}
{% endblock %}

{% block extrafooter %}
    {{ parent() }}
    <script src="{{ asset('js/multi-delete.js') }}"></script>
    <script>
        $(function() {
            initializeMultiDelete({
                buttonSelector: '#delete-selected-button',
                checkboxClass: 'team-checkbox',
                deleteUrl: '{{ path('jury_team_delete_multiple') }}'
            });
        });
    </script>
{% endblock %}