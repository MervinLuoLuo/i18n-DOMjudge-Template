{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}用户 {{ user.userid }} - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
    {{ knp_pagination_rel_links(submissions) }}
{% endblock %}

{% block content %}

    <h1>用户 {{ user.name }}</h1>

    <div class="row">
        <div class="col-lg-4">
            <table class="table table-sm table-striped">
                <tr>
                    <th>ID</th>
                    <td>{{ user.userid }}</td>
                </tr>
                <tr>
                    <th>外部 ID</th>
                    <td>{{ user.externalid }}</td>
                </tr>
                <tr>
                    <th>登录 ID</th>
                    <td class="teamid">{{ user.username }}</td>
                </tr>
                <tr>
                    <th>邮箱</th>
                    <td>
                        {% if user.email %}
                            <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>密码</th>
                    <td>
                        {% if user.password %}
                            已设置
                        {% else %}
                            未设置
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>IP</th>
                    <td>
                        {% if user.ipAddress %}
                            {{ user.ipAddress }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>是否启用</th>
                    <td>
                        {{ user.enabled | printYesNo }}
                    </td>
                </tr>
                <tr>
                    <th>权限</th>
                    <td>
                        {% for role in user.userRoles %}
                            {{ role.description }}<br>
                        {% else %}
                            未分配权限
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <th>所属队伍</th>
                    {% if user.team %}
                        <td class="teamid">
                            <a href="{{ path('jury_team', {'teamId': user.team.teamid}) }}">
                                {{ user.team.effectiveName }} {{ user.team | entityIdBadge('t') }}
                            </a>
                        </td>
                    {% else %}
                        <td>-</td>
                    {% endif %}
                </tr>
            </table>
        </div>

        <div class="col-lg-4">
            <table class="table table-sm table-striped">
                <tr>
                    <th>首次登录时间</th>
                    <td>
                        {% if user.firstLogin %}
                            {{ user.firstLogin | printtime('D d M Y H:i:s T') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>上次登录时间</th>
                    <td>
                        {% if user.lastLogin %}
                            {{ user.lastLogin | printtime('D d M Y H:i:s T') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>上次 API 登录时间</th>
                    <td>
                        {% if user.lastApiLogin %}
                            {{ user.lastApiLogin | printtime('D d M Y H:i:s T') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>最后一次登录 IP</th>
                    <td>
                        {% if user.lastIpAddress %}
                            {{ user.lastIpAddress | printHost(true) }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="button-row">
        {%- if is_granted('ROLE_ADMIN') -%}
            {{ button(path('jury_user_edit', {'userId': user.userid}), '编辑', 'primary', 'edit') }}
            {{ button(path('jury_user_delete', {'userId': user.userid}), '删除', 'danger', 'trash-alt', true) }}
        {% endif %}
        {% include 'jury/partials/rejudge_form.html.twig' with {table: 'user', id: user.userid, buttonClass: 'btn-secondary'} %}
    </div>

    <h2>提交： {{ user.name }}</h2>

    <div data-ajax-refresh-target>
        {%- include 'jury/partials/submission_list.html.twig' with {showTestcases: false} %}
    </div>

{% endblock %}
