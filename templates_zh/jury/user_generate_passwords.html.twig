{% extends "jury/base.html.twig" %}

{% block title %}随机生成密码 - {{ parent() }}{% endblock %}

{% block content %}

    <h1>随机生成密码</h1>

    <div class="alert alert-info" role="alert">为已登录用户随机生成新密码
    将导致其立即退出登录。</div>密码将按文档说明下载为 <a href="https://ccs-specs.icpc.io/2021-11/ccs_system_requirements?highlight=teams.tsv#accountstsv">csv 文件</a>.

    {{ form_start(form) }}
    {{form_row(form.group,{'label': '为选中的用户生成密码'})}}
    {{form_row(form.generate, {'label': '开始生成'})}}
    {{form_end(form)}}

{% endblock %}
