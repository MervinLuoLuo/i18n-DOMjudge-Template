{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}系统设置 - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.toggle_extrahead() }}
    {{ macros.select2_extrahead() }}
    <style>
        .btn.toggle-on {
            right: initial;
        }
    </style>
{% endblock %}

{% block content %}
    {% set config_category_map = {
        'Scoring': '计分',
        'Judging': '评测',
        'Clarifications': '公告 / 质询',
        'Display': '显示',
        'Authentication': '认证',
        'External systems': '外部系统'
    } %}

    {% set config_label_map = {
        'verification_required': '是否需要人工验证评测结果',
        'compile_penalty': '编译错误是否计入罚时',
        'penalty_time': '每次错误提交罚时',
        'results_prio': '结果优先级',
        'results_remap': '结果重映射',
        'score_in_seconds': '榜单按秒计分',
        'memory_limit': '最大内存限制',
        'output_limit': '最大输出限制',
        'process_limit': '进程数限制',
        'sourcesize_limit': '代码文件大小限制',
        'sourcefiles_limit': '代码文件数量限制',
        'script_timelimit': '编译 / 比较脚本时间限制',
        'script_memory_limit': '编译 / 比较脚本内存限制',
        'script_filesize_limit': '编译 / 比较脚本文件大小限制',
        'timelimit_overshoot': '时间限制超时宽限',
        'output_storage_limit': '输出存储限制',
        'lazy_eval_results': '懒评测',
