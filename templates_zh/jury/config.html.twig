        'judgehost_critical': '评测机严重时间',
        'diskspace_error': '磁盘空间错误阈值',
        'default_compare': '默认比较脚本',
        'default_run': '默认运行脚本',
        'default_full_debug': '默认完整调试脚本',
        'enable_parallel_judging': '并行评测',
        'judgehost_activated_by_default': '默认激活评测机',
        'clar_categories': '公告分类',
        'clar_answers': '预制质询回复',
        'clar_queues': '公告队列',
        'clar_default_problem_queue': '题目公告默认队列',
        'output_display_limit': '输出显示限制',
        'show_pending': '显示待评测提交',
