        'show_balloons_postfreeze': '封榜后发放气球',
        'show_relative_time': '显示相对时间',
        'time_format': '时间格式',
        'thumbnail_size': '缩略图大小',
        'show_limits_on_team_page': '队伍题目页显示限制',
        'allow_team_submission_download': '允许队伍下载提交代码',
        'team_column_width': '队伍列宽',
        'show_public_stats': '显示公共统计',
